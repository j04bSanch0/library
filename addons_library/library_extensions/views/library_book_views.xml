<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_book_tree_inherit" model="ir.ui.view">
        <field name="name">library.book.tree.inherit</field>
        <field name="model">library.book</field>
        <field name="inherit_id" ref="library.library_book_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="author_id"/>
                <field name="category_id" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_book_form_inherit" model="ir.ui.view">
        <field name="name">library.book.form.inherit</field>
        <field name="model">library.book</field>
        <field name="inherit_id" ref="library.library_book_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="author_id"/>
                <field name="category_id" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_book_category_tree" model="ir.ui.view">
        <field name="name">library.book.category.tree</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_book_category" model="ir.actions.act_window">
        <field name="name">Book Category</field>
        <field name="res_model">library.book.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>